nextflow_workflow {

    name "Test Fillout Workflow"
    script "../subworkflows/local/fillout.nf"
    workflow "FILLOUT"
    config "tests/fillouts.config"

    setup {
        run("PIPELINE_INITIALISATION") {
            script '../subworkflows/local/utils_nfcore_forte_pipeline/main.nf'
            config "tests/fillouts.config"
            workflow {
                """
                input[0] = false
                input[1] = false
                input[1] = true
                input[3] = []
                input[4] = "$outputDir"
                input[5] = params.input
                """
            }
        }
    }
    test("Should run without failures") {

        when {

            params {
                outdir = "$outputDir"
            }

            workflow {
                """
                input[0] = Channel.of([
                    ['sample':'SAMPLE_PAIRED_END','id':'SAMPLE_PAIRED_END'],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.rna.paired_end.sorted.bam", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    ['sample':'SAMPLE_PAIRED_END','id':'SAMPLE_PAIRED_END'],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/illumina/bam/test.rna.paired_end.sorted.bam.bai", checkIfExists: true)
                ])
                input[2] = PIPELINE_INITIALISATION.out.maf_samplesheet
                input[3] = file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)
                input[4] = file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai", checkIfExists: true)
                """
            }
        }

        then {
            def stable_name = getAllFilesFromDir(outputDir, relative:true, includeDir: true, include:['analysis/**/*'])
            def stable_path = getAllFilesFromDir(outputDir, ignore: ['pipeline_info/**'])

            assertAll(
                // workflow completes with success
                { assert workflow.success },
                // Number of successful tasks

                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    stable_name,
                    stable_path
                ).match() }
            )

        }
    }
}
